# --- Database ---
DATABASE_URL=postgresql://attendance:change_me@localhost:5432/attendance
TEST_DATABASE_URL=postgresql://attendance:change_me@localhost:5432/attendance_test
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Telegram (Giai đoạn 2) ---
BOT_TOKEN=
# Danh sách Telegram User ID admin, phân tách bằng dấu phẩy
ADMIN_TELEGRAM_IDS=

# Chỉ nhận ảnh điểm danh từ các chat này (ID group, thường âm: -100...). Để trống = nhận ở mọi chat
ATTENDANCE_CHAT_IDS=
# Thư mục lưu ảnh tạm trước khi xác minh xong
UPLOAD_TMP_DIR=tmp/photos

# --- Cloudinary (bắt buộc từ Giai đoạn 3) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Thư mục lưu ảnh trên Cloudinary (chữ/số/_/-, phân cấp bằng /). Ảnh lưu tại <thư mục>/<ngày>/<user>_<buổi>_<id>
CLOUDINARY_FOLDER=attendance
# true: đặt thêm asset_folder để ảnh hiện trong thư mục ở Media Library (tài khoản "dynamic folder mode", mặc định của
# tài khoản mới). Nếu upload báo lỗi liên quan asset_folder (tài khoản "fixed folder mode") thì đặt false.
CLOUDINARY_SET_ASSET_FOLDER=true

# --- Chung ---
TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Timemark verification (Giai đoạn 4) ---
TIMEMARK_URL=https://verify.timemark.com/
TIMEMARK_HEADLESS=true
TIMEMARK_RESULT_TIMEOUT_S=60
# Khoảng nghỉ tối thiểu giữa 2 lượt xác minh (tránh gửi quá dồn dập)
TIMEMARK_MIN_INTERVAL_S=5
SCREENSHOT_DIR=screenshots

# --- Văn phòng (Giai đoạn 5): chỉ nạp vào CSDL lần đầu nếu chưa có; sau đó dùng /office set trong chat riêng với bot ---
OFFICE_NAME=Văn phòng
OFFICE_LATITUDE=18.693679106009718
OFFICE_LONGITUDE=105.69232416307415

# --- Dashboard (Giai đoạn 6) ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
# Xem dữ liệu: không cần đăng nhập. Sửa/thao tác: admin đăng nhập bằng mã 6 số gửi qua Telegram (cần BOT_TOKEN;
# admin phải đã nhắn /start riêng cho bot).

# --- Vận hành (Giai đoạn 7) ---
# Ghi log ra file logs/app.log (chạy tay). Dịch vụ systemd tự đặt false và ghi vào journald.
LOG_TO_FILE=true
# Chỉ đặt true nếu Chromium không khởi động được vì sandbox (vd Ubuntu 24.04+ chặn user namespace). `main.py doctor` sẽ báo.
TIMEMARK_NO_SANDBOX=false
# Thư mục và số ngày giữ bản sao lưu PostgreSQL (deploy/backup.sh)
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
